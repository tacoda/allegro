# Presto standard library — written in presto, compiled into the binary and
# available to every program. OTP-lite (Retry, Supervisor) and composition
# (Orchestrator) built on result tuples and recursion, no processes.

# ---------------------------------------------------------------------------
# Retry — run a 0-arity function that returns {:ok, v} | {:error, r}, retrying
# on error with exponential backoff until `max` attempts are exhausted.
# ---------------------------------------------------------------------------
defmodule Retry do
  def run(fun), do: run(fun, 3, 50)
  def run(fun, max), do: run(fun, max, 50)
  def run(fun, max, backoff), do: attempt(fun, max, backoff, 1)

  defp attempt(fun, max, backoff, n) do
    case fun.() do
      {:ok, v} ->
        {:ok, v}

      {:error, r} ->
        if n >= max do
          {:error, r}
        else
          Process.sleep(backoff * n)
          attempt(fun, max, backoff, n + 1)
        end
    end
  end
end

# ---------------------------------------------------------------------------
# Supervisor — run child specs {id, fun}, restarting (retrying) failures.
# Strategy :one_for_one restarts each child independently; the result is a list
# of {id, :ok, value} | {id, :error, reason}.
# ---------------------------------------------------------------------------
defmodule Supervisor do
  def run(children), do: run(children, 3)

  def run(children, max_restarts) do
    results = Enum.map(children, fn child -> supervise(child, max_restarts) end)
    {:ok, results}
  end

  defp supervise({id, fun}, max_restarts) do
    case Retry.run(fun, max_restarts) do
      {:ok, v} -> {id, :ok, v}
      {:error, r} -> {id, :error, r}
    end
  end
end

# ---------------------------------------------------------------------------
# Orchestrator — compose stage functions (each: input -> {:ok, out}|{:error,r}).
# `sequence` threads input through stages, short-circuiting on error.
# `parallel` runs every stage on the same input and gathers the results.
# ---------------------------------------------------------------------------
defmodule Orchestrator do
  def sequence(input, []), do: {:ok, input}

  def sequence(input, [stage | rest]) do
    case stage.(input) do
      {:ok, out} -> sequence(out, rest)
      {:error, r} -> {:error, r}
    end
  end

  def parallel(input, stages) do
    Enum.map(stages, fn stage -> stage.(input) end)
  end
end
